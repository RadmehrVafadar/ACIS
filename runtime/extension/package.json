{
  "name": "interview-workbench",
  "publisher": "acis",
  "displayName": "Interview Workbench",
  "version": "1.0.0",
  "engines": { "vscode": "^1.95.0" },
  "activationEvents": ["onStartupFinished", "onDebugResolve:debugpy"],
  "main": "./extension.cjs",
  "contributes": {
    "debuggers": [{
      "type": "debugpy",
      "label": "Python Debugger",
      "languages": ["python"],
      "configurationAttributes": { "launch": { "properties": {} } },
      "initialConfigurations": [{ "type": "debugpy", "request": "launch", "name": "Debug Python" }]
    }]
  }
}

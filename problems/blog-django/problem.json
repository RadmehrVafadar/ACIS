{
  "id": "blog-django",
  "title": "Post Creation",
  "description": "Repair publishing in a community blog using Django REST Framework and PostgreSQL.",
  "runtime": "django",
  "database": "postgres",
  "sharedBlog": true,
  "ports": [
    {
      "port": 8080,
      "label": "API",
      "path": "/"
    },
    {
      "port": 8000,
      "label": "Blog",
      "path": "/"
    }
  ],
  "protected": [
    "README.md",
    "setup.sh",
    "seed.sh",
    "test.sh",
    "requirements.txt",
    "pytest.ini",
    "backend/config/settings.py",
    "backend/blog/data/seed.json",
    "backend/blog/management/commands/seed.py",
    "backend/blog/tests/test_posts.py"
  ],
  "variants": [
    {
      "id": "01",
      "failures": 2
    },
    {
      "id": "02",
      "failures": 2
    },
    {
      "id": "03",
      "failures": 2
    }
  ],
  "durationMinutes": 60,
  "install": [
    "bash",
    "setup.sh"
  ],
  "seed": [
    "bash",
    "seed.sh"
  ],
  "run": [
    "bash",
    "run.sh"
  ],
  "test": [
    "bash",
    "test.sh"
  ]
}

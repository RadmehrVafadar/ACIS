{
  "compilerOptions": {
    "paths": { "@/*": ["./web/src/*"] },
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
